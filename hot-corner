#!/bin/zsh
# macOS hot corners cannot run commands, so the corner is set to start the screen saver and the Dock's notification for it triggers doff
/usr/bin/log stream --style compact --predicate 'process == "Dock" AND eventMessage CONTAINS "com.apple.screensaver.action"' | while read -r line; do
  case $line in
    *"posted com.apple.screensaver.action"*) "$HOME/.config/doff/doff" < /dev/null ;;
  esac
done
